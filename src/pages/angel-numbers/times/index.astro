---
import { getCollection, render } from 'astro:content';
import Article from '../../../layouts/Article.astro';
import { allTimes, wordCount, readMinutes } from '../../../lib/content.mjs';

const hubs = await getCollection('hubs');
const entry = hubs.find((h) => h.data.slug === 'times');
const { Content, headings } = await render(entry);
const times = allTimes();
const crumbs = [{ label: 'Angel numbers', href: '/angel-numbers/' }, { label: 'Clock times', href: '/angel-numbers/times/' }];
const words = wordCount(entry.body) + 100;
const allHeadings = [...headings, { depth: 2, slug: 'list', text: 'Every clock time on the site' }, ...(entry.data.faq.length ? [{ depth: 2, slug: 'faq', text: 'Questions people ask' }] : [])];
---
<Article title={entry.data.title} description={entry.data.description} h1={entry.data.h1} lead={entry.data.lead} crumbs={crumbs} eyebrow="Clock times"
  published={entry.data.published} updated={entry.data.updated} readMinutes={readMinutes(words)} faq={entry.data.faq} headings={allHeadings} ogImage="/og/hub-times.png" current="angel">
  <Content />
  <Fragment slot="after">
    <div class="prose" style="margin-top:36px">
      <section aria-labelledby="list">
        <h2 id="list">Every clock time on the site</h2>
        <p>Type any other time into the lookup box and the site works it out on the spot.</p>
        <div class="grid grid--small">{times.map((t) => <a class="small-card" href={t.href}><span class="small-card__num">{t.n}</span><span class="small-card__line">{t.line}</span></a>)}</div>
      </section>
    </div>
  </Fragment>
</Article>
