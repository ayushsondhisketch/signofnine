---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import Related from '../../components/Related.astro';
import { allAngelNumbers, allTimes, wordCount, readMinutes } from '../../lib/content.mjs';

const hubs = await getCollection('hubs');
const entry = hubs.find((h) => h.data.slug === 'index');
const { Content, headings } = await render(entry);
const all = await allAngelNumbers();
const editorial = all.filter((a) => a.kind === 'editorial');
const computed = all.filter((a) => a.kind === 'computed');
const times = allTimes();
const guides = hubs.filter((h) => !['index', 'times'].includes(h.data.slug)).map((h) => ({ slug: h.data.slug, title: h.data.h1, line: h.data.lead }));
const crumbs = [{ label: 'Angel numbers', href: '/angel-numbers/' }];
const words = wordCount(entry.body) + 200;
const allHeadings = [...headings, { depth: 2, slug: 'all', text: 'Every angel number on the site' }, { depth: 2, slug: 'times', text: 'Clock times' }, { depth: 2, slug: 'guides', text: 'Guides by question' }, ...(entry.data.faq.length ? [{ depth: 2, slug: 'faq', text: 'Questions people ask' }] : [])];
---
<Article title={entry.data.title} description={entry.data.description} h1={entry.data.h1} lead={entry.data.lead} crumbs={crumbs} eyebrow="Angel numbers"
  published={entry.data.published} updated={entry.data.updated} readMinutes={readMinutes(words)} faq={entry.data.faq} headings={allHeadings} ogImage="/og/hub-index.png" current="angel">
  <Content />
  <Fragment slot="after">
    <div class="prose" style="margin-top:36px">
      <section aria-labelledby="all">
        <h2 id="all">Every angel number on the site</h2>
        <p>The eleven numbers people search for most have full guides. The rest are shorter pages built the same way, with the arithmetic shown and the reading named.</p>
        <div class="grid" style="--tile-min:200px">
          {editorial.map((a) => <a class="tile" href={a.href}><span class="eyebrow">Angel number</span><span class="tile__num">{a.n}</span><span class="tile__line">{a.line}</span><span class="tile__more">Read the meaning →</span></a>)}
        </div>
        {computed.length > 0 && <div class="grid grid--small" style="margin-top:8px">{computed.map((a) => <a class="small-card" href={a.href}><span class="small-card__num">{a.n}</span><span class="small-card__line">{a.line}</span></a>)}</div>}
      </section>
      <section aria-labelledby="times">
        <h2 id="times">Clock times</h2>
        <p>A number on the clock is read the same way as the number alone, with one extra question: why you were looking at that moment. <a href="/angel-numbers/times/">The clock-time guide</a> covers the mirror hours and the 24-hour times UK readers search for.</p>
        <div class="grid grid--small">{times.map((t) => <a class="small-card" href={t.href}><span class="small-card__num">{t.n}</span><span class="small-card__line">{t.line}</span></a>)}</div>
      </section>
      <section aria-labelledby="guides">
        <h2 id="guides">Guides by question</h2>
        <p>The same numbers, sorted by the question people bring to them.</p>
        <ul>{guides.map((g) => <li><a href={`/angel-numbers/${g.slug}/`}>{g.title}</a>: {g.line}</li>)}</ul>
      </section>
    </div>
  </Fragment>
</Article>
