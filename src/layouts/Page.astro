---
// Fixed pages: title band without a ring, content panel, sidebar.
import Base from './Base.astro';
import Band from '../components/Band.astro';
import Sidebar from '../components/Sidebar.astro';
import { breadcrumbSchema } from '../lib/content.mjs';
const { title, description, h1, lead = '', crumbs = [], eyebrow = '', noindex = false, updated = '', extraSchema = [], ogImage = '/og/default.png', sidebar = true } = Astro.props;
---
<Base title={title} description={description} noindex={noindex} schema={[breadcrumbSchema(crumbs), ...extraSchema]} ogImage={ogImage}>
  <Band crumbs={crumbs} eyebrow={eyebrow} title={h1 || title} lead={lead} updated={updated} system={false} />
  <div class="layout">
    <div class="wrap">
      <article class="panel" data-pagefind-body><div class="prose"><slot /></div></article>
      {sidebar && <Sidebar />}
    </div>
  </div>
</Base>
