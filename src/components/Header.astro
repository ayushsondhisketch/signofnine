---
import Star from './Star.astro';
import { SITE, NAV, TOP_LINKS } from '../site.mjs';
const { current = '' } = Astro.props;
---
<div class="topbar">
  <div class="wrap">
    <div class="topbar__tag"><Star size={14} /><span>{SITE.tagline}</span></div>
    <div class="topbar__links">{TOP_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}</div>
  </div>
</div>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label={`${SITE.name} home`}><Star size={30} /><span class="brand__word">{SITE.name}</span></a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Menu" data-menu>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <nav class="nav" id="primary-nav" aria-label="Primary">
      {NAV.map((n) => <a href={n.href} aria-current={n.key === current ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <form class="search" action="/search/" method="get" role="search">
      <label class="visually-hidden" for="site-search">Search the site</label>
      <input id="site-search" name="q" type="search" placeholder="Search…" autocomplete="off" />
      <button type="submit" aria-label="Search"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.6-3.6"></path></svg></button>
    </form>
  </div>
</header>
<script>
  const btn = document.querySelector('[data-menu]');
  const nav = document.getElementById('primary-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
