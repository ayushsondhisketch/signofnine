---
// The In short box: the first 100 words of every page. Either a definition list (number pages) or a short list (articles).
import Star from './Star.astro';
const { items = [], lines = [], lead = '' } = Astro.props;
---
<div class="inshort">
  <div class="inshort__title"><Star size={16} /><h2 id="in-short">In short</h2></div>
  {lead && <p class="lead-p">{lead}</p>}
  {items.length > 0 && (
    <dl>
      {items.map(([k, v]) => <div><dt>{k}</dt><dd set:html={v}></dd></div>)}
    </dl>
  )}
  {lines.length > 0 && (
    <ul>
      {lines.map((l) => <li set:html={l}></li>)}
    </ul>
  )}
</div>
